{
  "project_name": "FastAPI Bootstrap",
  "project_slug": "{{ cookiecutter.project_name.lower().replace(' ', '-').replace('_', '-') }}",
  "package_name": "{{ cookiecutter.project_slug.replace('-', '_') }}",
  "project_description": "Production-grade FastAPI backend with auth (JWT+OAuth+RBAC) and LLM chat proxy domains.",
  "author_name": "Your Name",
  "author_email": "you@example.com",
  "python_version": "3.12",
  "fastapi_host": "0.0.0.0",
  "fastapi_port": "8000",
  "postgres_host": "localhost",
  "postgres_port": "5432",
  "postgres_user": "app",
  "postgres_password": "app",
  "postgres_db": "{{ cookiecutter.package_name }}_db",
  "redis_host": "localhost",
  "redis_port": "6379",
  "redis_db": "0",
  "mailpit_smtp_port": "1025",
  "mailpit_ui_port": "8025",
  "jwt_access_ttl_minutes": "15",
  "jwt_refresh_ttl_days": "7",
  "include_chat_domain": ["yes", "no"],
  "llm_provider": ["openai", "anthropic", "gemini", "azure", "ollama"],
  "llm_default_model": "gpt-4o-mini",
  "oauth_providers": ["google,kakao,naver", "google", "kakao", "naver", "google,kakao", "google,naver", "kakao,naver", "none"],
  "use_pre_commit": ["yes", "no"],
  "license": ["MIT", "Apache-2.0", "Proprietary"],
  "_copy_without_render": [
    "*.j2"
  ],
  "__prompts__": {
    "project_name": "Human-readable project name",
    "project_slug": "Slug used for repo / docker-compose project (auto-derived)",
    "package_name": "Python package name under src/ (auto-derived)",
    "python_version": "Python version (>= 3.12 required)",
    "postgres_db": "PostgreSQL database name",
    "include_chat_domain": "Include LangChain + langchain-litellm chat proxy domain?",
    "llm_provider": "Default LLM provider for chat domain (ignored if chat domain disabled)",
    "oauth_providers": "Comma-separated OAuth providers to scaffold (others are removed post-gen)",
    "use_pre_commit": "Install pre-commit hooks (ruff + mypy)?",
    "license": "Project license"
  }
}
